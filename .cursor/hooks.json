{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/agent_capture.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/agent_capture.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python .cursor/hooks/agent_capture.py"
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/agent_capture.py"
      }
    ]
  }
}
