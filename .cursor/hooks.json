{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/run-capture.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/run-capture.mjs"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/run-capture.mjs"
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/run-capture.mjs"
      }
    ]
  }
}
